# Server-only — set in Vercel → Project → Settings → Environment Variables
# (Production + Preview). Never commit real keys.
#
# Prefer SERVICE_ROLE for the share API (tables are locked down for anon).
# The anon key alone can no longer insert/update mypipcam_* tables.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional fallback for local experiments only:
# SUPABASE_ANON_KEY=your_anon_key
