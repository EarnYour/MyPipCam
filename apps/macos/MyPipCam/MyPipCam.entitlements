<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Sandbox microphone capability -->
	<key>com.apple.security.device.microphone</key>
	<true/>
	<!-- Hardened Runtime microphone TCC (required when ENABLE_HARDENED_RUNTIME=YES;
	     without this, tccd logs "Policy disallows prompt" for kTCCServiceMicrophone). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Best-effort Chromium profile probes for “Open in Chrome…”.
	     On recent macOS, sandbox may still deny reading Preferences (EPERM) while
	     allowing fileExists on known paths — detection falls back to metadata probes
	     and opens the HTTPS bridge without a false “Not Detected” dialog. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>Library/Application Support/Google/Chrome/</string>
		<string>Library/Application Support/Google/Chrome Canary/</string>
		<string>Library/Application Support/Google/Chrome Beta/</string>
		<string>Library/Application Support/Google/Chrome for Testing/</string>
		<string>Library/Application Support/Google/ChromeForTesting/</string>
		<string>Library/Application Support/Chromium/</string>
		<string>Library/Application Support/BraveSoftware/Brave-Browser/</string>
		<string>Library/Application Support/Microsoft Edge/</string>
		<string>Library/Application Support/Arc/</string>
		<string>Library/Application Support/Arc/User Data/</string>
		<string>Library/Application Support/Vivaldi/</string>
		<!-- One-time LoomCam → MyPipCam UserDefaults migration -->
		<string>Library/Containers/com.stevenmartinez.LoomCam/Data/Library/Preferences/</string>
	</array>
	<!-- Fallback: tell Chrome to open chrome-extension:// library URLs -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.temporary-exception.apple-events</key>
	<array>
		<string>com.google.Chrome</string>
		<string>com.google.Chrome.canary</string>
		<string>company.thebrowser.Browser</string>
		<string>com.brave.Browser</string>
		<string>com.microsoft.edgemac</string>
		<string>com.vivaldi.Vivaldi</string>
		<string>org.chromium.Chromium</string>
	</array>
</dict>
</plist>
