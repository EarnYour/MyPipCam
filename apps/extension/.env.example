# Copy to `.env.local` (gitignored) for local builds, then rebuild:
#   cp .env.example .env.local && npm run build
# Chrome-extension OAuth *client ID* only — never a client_secret.
# Google Cloud Item ID must match the extension ID on chrome://extensions
# (stable with manifest key: akpchobfndfddajiihkkdpnihihdicjc).
# See AGENTS.md and README.md § Google Drive.

VITE_GOOGLE_OAUTH_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
